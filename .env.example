# DATABASE_URL: Required for Cloud SQL PostgreSQL connection.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SISPAT_API_KEY: secret used to protect internal database and AI endpoints in production.
# Generate a long random value and configure it only on the server.
SISPAT_API_KEY="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"

# JWT_SECRET: secret used to sign central authentication tokens (login via PostgreSQL/Neon).
# REQUIRED in production (the API returns 503 while missing). Generate a long random value.
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
